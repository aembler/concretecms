{% set items = breadcrumb.getItems() %}
{% set total = items|length %}
{% if total > 1 %}
    <div class="breadcrumbs text-sm text-base-content/70">
        <ul>
            {% for item in items %}
                <li>
                    {% set children = item.getChildren() %}
                    {% if children|length %}
                        <div class="dropdown">
                            <label tabindex="0" class="cursor-pointer inline-flex items-center gap-1">
                                {{ item.getName() }}
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 opacity-70" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                                </svg>
                            </label>
                            <ul tabindex="0" class="dropdown-content menu rounded-box z-10 mt-2 w-56 bg-base-100 p-2 shadow-lg border border-base-300">
                                {% for child in children %}
                                    <li>
                                        <a href="{{ child.getUrl() }}">
                                            {{ child.getName }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% elseif isActive %}
                        <span aria-current="page">
                            {{ item.getName }}
                        </span>
                    {% else %}
                        <a href="{{ item.getURL() }}">
                            {{ item.getName }}
                        </a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </div>
{% endif %}
