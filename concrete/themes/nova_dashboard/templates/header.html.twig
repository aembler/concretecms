<header class="navbar navbar-expand-lg">
    <div class="container-fluid">

        {# Logo #}
        <a class="navbar-brand d-flex align-items-center" href="{{ view.url('/') }}">
            <img src="{{ view.getThemePath() }}/images/mwr-logo.svg"
                 alt="MWR Contests Logo"
                 class="me-2"
                 style="height: 40px;">
            <div class="logo-text">
                {{ t('Games') }}
            </div>
        </a>

        {# Mobile toggle #}
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar"
                aria-controls="mainNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        {# Nav Content #}
        <div class="collapse navbar-collapse" id="mainNavbar">

            {# Left Nav Items #}
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="{{ view.url('/submit-entry') }}">Submit Entry</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ view.url('/sponsor-a-contest') }}">Sponsor a Contest</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ view.url('/past-winners') }}">Past Winners</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ view.url('/contact-us') }}">Contact Us</a>
                </li>
            </ul>

            {# Right-aligned button #}
            <div class="d-flex">

                {% set user = current_user_info() %}
                {% guard function community_profile %}
                    {% set profile = community_profile() %}
                    {% set logoutUri = logout_uri() %}
                {% endguard %}
                {% if user and profile %}
                    <a href="{{ profile.profileUrl }}">
                        <img src="{{ user.getUserAvatar.getPath }}" class="avatar" />
                    </a>
                    <a href="{{ logoutUri }}">Logout</a>
                {% else %}
                    <a class="btn btn-outline-primary btn" href="{{ view.url('/login') }}">Log In</a>
                {% endif %}
            </div>

        </div>
    </div>
</header>
