<aside class="fixed inset-y-0 left-0 top-16 z-40 hidden w-72 border-r border-base-300 bg-base-100 lg:block">
    <div class="h-full overflow-y-auto px-4 py-6">
        <ul class="menu menu-lg w-full gap-1 rounded-box bg-base-100 p-0 text-sm">
            {% for hub in _hubs %}
                <li>
                    <a href="{{ hub.getHomePageUrl }}" class="rounded-lg">
                        <span class="h-5 w-5 shrink-0 text-base-content/70">{{ hub.getIcon.toHtmlObject|raw }}</span>
                        {{ hub.getLabel }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
</aside>
