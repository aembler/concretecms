<!DOCTYPE html>
<html lang="{{ active_language() }}">
    <head>
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        {{ element('header_required', {
            'pageTitle': pageTitle ? pageTitle,
            'pageDescription': pageDescription ? pageDescription,
            'pageMetaKeywords': pageMetaKeywords ? pageMetaKeywords,
        }) | raw }}
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        {{ vite('@assets/themes/nova_dashboard/js/main.js') }}
        {{ vite('@assets/themes/nova_dashboard/css/main.css') }}
    </head>
    <body class="min-h-screen bg-base-200 text-base-content">
        {% block header %}
            {% include '@theme/templates/header.html.twig' %}
        {% endblock %}

        <div class="mx-auto w-full max-w-screen-2xl lg:flex lg:items-start">
            <aside class="sticky top-16 z-40 hidden h-[calc(100vh-4rem)] w-72 shrink-0 self-start border-r border-base-300 bg-base-200 lg:block">
                <div class="h-full overflow-y-auto px-2 py-6">
                    {% include '@theme/templates/sidebar.html.twig' %}
                </div>
            </aside>

            <main class="flex min-h-[calc(100vh-7.5rem)] w-full flex-1 flex-col px-4 py-6 sm:px-6 lg:px-8 bg-base-100">
                {% block content %}{% endblock %}
            </main>
        </div>

        {% block footer %}
            {% include '@theme/templates/footer.html.twig' %}
        {% endblock %}

        {% if c %}
            {{ element('footer_required') | raw }}
        {% else %}
            {{ view.markFooterAssetPosition() | raw }}
        {% endif %}
    </body>
</html>
