{
  "name": "concreteCMS",
  "scripts": {
    "dev": "vite",
    "development": "vite",
    "watch": "vite build --watch --mode development",
    "watch-poll": "vite build --watch --mode development",
    "hot": "vite",
    "prod": "vite build && node ./vite.build.mjs --mode production",
    "production": "vite build && node ./vite.build.mjs --mode production",
    "vite:dev": "vite",
    "vite:watch": "vite build --watch --mode development",
    "vite:prod": "vite build",
    "sass:deprecations": "SASS_REPORT_DEPRECATIONS=1 vite build",
    "compat:sass:deprecations": "SASS_REPORT_DEPRECATIONS=1 node ./vite.build.mjs --mode production",
    "compat:dev": "node ./vite.build.mjs --mode development",
    "compat:watch": "node ./vite.build.mjs --mode development --watch",
    "compat:prod": "node ./vite.build.mjs --mode production"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@concretecms/backendui": "0.0.0",
    "@concretecms/bedrock": "0.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/tsconfig": "^0.7.0",
    "@tiptap/extension-text-align": "^2.11.4",
    "canvas-confetti": "^1.9.3",
    "daisyui": "^5.0.0",
    "sass": "^1.86.3",
    "typescript": "^5.8.3",
    "vite": "^5.4.14",
    "vue-tsc": "^2.2.8"
  },
  "packageManager": "yarn@4.6.0+sha224.acd0786f07ffc6c933940eb65fc1d627131ddf5455bddcc295dc90fd",
  "resolutions": {
    "@concretecms/backendui": "portal:../../../concrete-backend",
    "@concretecms/bedrock": "portal:../../../bedrock",
    "vue": "3.5.29"
  }
}
